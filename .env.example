# ---- Browser (safe to expose) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Subscriptions: leave false while building. Set true (and flip app_settings in Supabase) to start charging.
VITE_BILLING_ENABLED=false

# ---- Only needed once VITE_BILLING_ENABLED=true ----
# ---- Netlify Functions only (set in Netlify > Site settings > Environment variables) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx
# Optional free trial length for new subscribers (0 = no trial)
STRIPE_TRIAL_DAYS=7
# Your live site URL (used for Stripe return links)
SITE_URL=https://your-site.netlify.app
